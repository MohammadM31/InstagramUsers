# --- Required: the API refuses to start without valid values (see src/config.js) ---
# Generate your own secrets (run twice, once per variable):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit your real .env. The two values below are placeholders and are rejected at boot until you replace them.
# Rotating ENCRYPTION_KEY makes every stored API key unreadable (users must re-save them). Changing JWT_SECRET signs everyone out.
DATABASE_URL=postgres://ge:ge@localhost:5432/ge
REDIS_URL=redis://localhost:6379
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_STRING_OF_32_OR_MORE_CHARS
ENCRYPTION_KEY=REPLACE_ME_WITH_64_HEX_CHARS
# Comma-separated allowed origins. Set this in production.
CORS_ORIGIN=http://localhost:5173
# Runs the scrape/import/image/publisher workers and the daily snapshot job inside the API process.
INLINE_WORKER=1
# --- AI (OpenAI-compatible; DeepSeek works: LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat) ---
# Gemini also works: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# A key a user saves in Settings (openai) is tried first and always talks to api.openai.com; these are the fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# --- Images (same Replicate token as ProductAI). A key saved in Settings (replicate) is tried first. ---
REPLICATE_API_TOKEN=
# flux-1.1-pro, flux-schnell, flux-dev, recraft-v4, flux-kontext-pro, flux-kontext-max, nano-banana
IMAGE_MODEL=flux-1.1-pro
# --- Instagram Graph API (optional): enables real competitor data, importing your own posts from Instagram, and publishing ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# --- Instagram connection for users (roadmap A.0 / A.1a): Facebook Login for Business. Create the Meta app in development mode first. ---
# META_REDIRECT_URI must be registered in the Meta app and point at THIS server: https://<your-host>/api/instagram/connect/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Where the browser returns after connecting (defaults to the origin of META_REDIRECT_URI).
APP_URL=
# Graph API version used for every call (default v25.0, supported until 2028-02). Bump here, nowhere else.
META_GRAPH_VERSION=
# Production only: set 1 to let the global IG_USER_ID / IG_ACCESS_TOKEN above act as a fallback for users who never connected (dev/demo use).
IG_ALLOW_ENV_FALLBACK=
# A.1d: shown on the public /privacy page (a loud DRAFT banner appears until both are set). Register /privacy, /api/instagram/deauthorize and
# /api/instagram/data-deletion in the Meta app dashboard (A.0). Review the policy text before submitting to Meta.
PRIVACY_OPERATOR=
PRIVACY_CONTACT_EMAIL=
# --- C.1 public image storage (any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO). Set ALL six or none. The bucket must allow public READ
# of objects (Instagram fetches the url); keep uploads private to this app's key. Objects get random 128-bit names. Add a bucket lifecycle rule to expire old images. ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Stored images older than this many days are deleted from the bucket by an hourly job (1-365, default 30). Images of deleted accounts are removed at once.
IMAGE_RETENTION_DAYS=
