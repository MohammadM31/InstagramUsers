DATABASE_URL=postgres://ge:ge@localhost:5432/ge
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
ENCRYPTION_KEY=   # 64 hex chars: openssl rand -hex 32
CORS_ORIGIN=http://localhost:5173
INLINE_WORKER=1
# AI (OpenAI-compatible; DeepSeek works: LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat)
# Gemini also works (OpenAI-compatible): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Images (same Replicate token as ProductAI)
REPLICATE_API_TOKEN=
# Model key from ProductAI's registry: flux-1.1-pro, flux-schnell, flux-dev, recraft-v4, flux-kontext-pro, flux-kontext-max, nano-banana
IMAGE_MODEL=flux-1.1-pro
# Instagram Graph API (optional; without it scraping runs in demo mode)
IG_USER_ID=
IG_ACCESS_TOKEN=
