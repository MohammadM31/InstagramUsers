+      log.log(`OWNER_EMAIL: ${email} is now the platform owner (was ${u.role}).`);
+      return { status: 'promoted', userId: u.id, from: u.role };
+    } catch (e) { log.error('owner bootstrap failed:', e.message); return { status: 'error' }; }
+  };
+}
